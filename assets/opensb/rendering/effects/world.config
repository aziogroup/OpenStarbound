{
  "frameBuffer" : "main",

  "effectParameters" : {
    "lightMapEnabled" : {
      "type" : "bool",
      "default" : true,
      "uniform" : "lightMapEnabled"
    },
    "lightMapScale" : {
      "type" : "vec2",
      "default" : [1, 1],
      "uniform" : "lightMapScale"
    },
    "lightMapOffset" : {
      "type" : "vec2",
      "default" : [0, 0],
      "uniform" : "lightMapOffset"
    },
    "lightMapMultiplier" : {
      "type" : "float",
      "default" : 1.0,
      "uniform" : "lightMapMultiplier"
    },
    "vertexRounding" : {
      "type" : "bool",
      "default" : false,
      "uniform" : "vertexRounding"
    },
    "gpuLightingEnabled" : {
      "type" : "bool",
      "default" : false,
      "uniform" : "gpuLightingEnabled"
    },
    "lightCount" : {
      "type" : "int",
      "default" : 0,
      "uniform" : "lightCount"
    },
    "occlusionOffset" : {
      "type" : "vec2",
      "default" : [0, 0],
      "uniform" : "occlusionOffset"
    },
    "lightMapWorldOrigin" : {
      "type" : "vec2",
      "default" : [0, 0],
      "uniform" : "lightMapWorldOrigin"
    },
    "weatherIntensity" : {
      "type" : "float",
      "default" : 0.0,
      "uniform" : "weatherIntensity"
    },
    "windStrength" : {
      "type" : "float",
      "default" : 0.0,
      "uniform" : "windStrength"
    },
    "dayLevel" : {
      "type" : "float",
      "default" : 1.0,
      "uniform" : "dayLevel"
    },
    "gameTime" : {
      "type" : "float",
      "default" : 0.0,
      "uniform" : "gameTime"
    }
  },

  "effectTextures" : {
    "lightMap" : {
      "textureUniform" : "lightMap",
      "textureSizeUniform" : "lightMapSize",
      "textureAddressing" : "clamp",
      "textureFiltering" : "linear"
    },
    "occlusionMap" : {
      "textureUniform" : "occlusionMap",
      "textureSizeUniform" : "occlusionMapSize",
      "textureAddressing" : "clamp",
      "textureFiltering" : "linear"
    },
    "lightData" : {
      "textureUniform" : "lightData",
      "textureAddressing" : "clamp",
      "textureFiltering" : "nearest"
    }
  },

  "effectShaders" : {
    "vertex" : "world.vert",
    "fragment" : "world.frag"
  }
}
