  "^#e43774;[FR]^reset; Player Bonuses (%%status.statusProperty(\"fr_enabled\")%%)": "^#e43774;[FR]^reset; プレイヤーボーナス (%%status.statusProperty(\"fr_enabled\")%%)",
  "^cyan;[FU]^reset; BYOS Atmosphere (%%world.getProperty(\"fu_byos.newAtmosphereSystem\")%%)": "^cyan;[FU]^reset; BYOS大気 (%%world.getProperty(\"fu_byos.newAtmosphereSystem\")%%)",
  "^cyan;[FU]^reset; Configure Ship Pet": "^cyan;[FU]^reset; 船のペット設定",
