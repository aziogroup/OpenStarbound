  "Yo-ho-ho and a bottle of rum!\n^white;35% ^red;Slow ^gray;, ^red;Drunk ^gray;(^white;1m^gray;)^reset;": "ヨーホーホー、ラム酒一本！\n^white;35% ^red;鈍足^gray;、^red;酔い^gray;（^white;1分^gray;）^reset;",
  "Amber Rum": "琥珀ラム",
  "Ambrosia": "アンブロシア",
  "The drink of the Gods.\n^cyan;+^white;70 ^red;HP^gray;, ^red;Drunk^gray;, ^green;Heal ^white;125 ^gray;(^white;1m^gray;)^reset;": "神々の飲み物\n^cyan;+^white;70 ^red;HP^gray;, ^red;酔い^gray;, ^green;回復 ^white;125 ^gray;(^white;1m^gray;)^reset;",
