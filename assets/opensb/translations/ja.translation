  "^yellow;^reset;^cyan;Immune^reset;: Proto-Poison: 2m\n^yellow;^reset;^cyan;Heal 60% HP^reset;: 90s": "^yellow;^reset;^cyan;免疫^reset;: プロト毒: 2m\n^yellow;^reset;^cyan;回復 60% HP^reset;: 90s",
  "Vorit Cap": "Voritキャップ",
